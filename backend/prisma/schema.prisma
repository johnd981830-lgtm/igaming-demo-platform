generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum LedgerType {
  DEPOSIT
  WITHDRAW
  BET
  WIN
}

enum BetStatus {
  OPEN
  WON
  LOST
}

model User {
  id        String        @id @default(uuid())
  email     String        @unique
  password  String
  username  String        @unique
  balance   Decimal       @default(2500) @db.Decimal(12, 2)
  role      UserRole      @default(USER)
  createdAt DateTime      @default(now())
  ledger    LedgerEntry[]
  bets      Bet[]
}

model LedgerEntry {
  id          String     @id @default(uuid())
  userId      String
  type        LedgerType
  amount      Decimal    @db.Decimal(12, 2)
  currency    String     @default("USD")
  description String
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Match {
  id        String   @id
  home      String
  away      String
  league    String
  startAt   DateTime
  markets   Market[]
  bets      Bet[]
}

model Market {
  id      String @id @default(uuid())
  matchId String
  label   String
  odds    Decimal @db.Decimal(8, 2)
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  @@unique([matchId, label])
}

model Game {
  id         String @id
  title      String
  category   String
  volatility String
  rtp        Decimal @db.Decimal(5, 2)
  provider   String
  image      String
}

model Bet {
  id         String     @id @default(uuid())
  userId     String
  matchId    String
  selection  String
  stake      Decimal    @db.Decimal(12, 2)
  odds       Decimal    @db.Decimal(8, 2)
  status     BetStatus  @default(OPEN)
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  match      Match      @relation(fields: [matchId], references: [id])
  @@index([userId, createdAt])
}
